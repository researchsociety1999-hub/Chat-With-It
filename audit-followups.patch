+
+/* Larger touch targets for small controls on coarse pointers */
+@media (pointer: coarse) {
+  .profile-btn { min-height: 44px; min-width: 44px; }
+  #scrollToBottom { width: 44px; height: 44px; }
+}
+
+/* Reduced motion: stop the remaining looping and entry animations */
+@media (prefers-reduced-motion: reduce) {
+  .chat-body { scroll-behavior: auto; }
+  .typing-indicator span, .msg-bubble.streaming::after, #stopBtn.streaming-visible, .ctx-fill.over,
+  .sidebar.open, .mobile-overlay.show, #profilesPanel { animation: none; }
+}
