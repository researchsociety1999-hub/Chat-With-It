{
  "name": "chatwithit",
  "version": "1.0.1",
  "private": true,
  "description": "ChatWithIt \u2014 privacy-first browser-only multi-provider AI chat. No backend. Keys stay in memory.",
  "scripts": {
    "dev": "esbuild js/app.js --bundle --outfile=dist/app.js --servedir=.",
    "start": "npx serve -p 3000",
    "build": "esbuild js/app.js --bundle --minify --outfile=dist/app.js",
    "lint": "echo 'No linter configured'",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "dompurify": "^3.4.12",
    "esbuild": "^0.28.1",
    "html2canvas": "^1.4.1",
    "jsdom": "^29.1.1",
    "jspdf": "^4.2.1",
    "pdfjs-dist": "^6.1.200",
    "serve": "^14.2.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0",
    "dotenv": "^17.4.2",
    "marked": "^18.0.6"
  }
}
