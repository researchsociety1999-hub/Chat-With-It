{
  "name": "chatwithit",
  "version": "1.0.1",
  "private": true,
  "description": "Private browser-based AI chat for 100+ models via OpenRouter, Hugging Face, or local OpenAI-compatible endpoints — named conversations, search, attachments, and PWA install",
  "scripts": {
    "dev": "esbuild js/app.js --bundle --outfile=dist/app.js --servedir=.",
    "build": "esbuild js/app.js --bundle --minify --outfile=dist/app.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "echo 'No linter configured'",
    "start": "npx serve -p 3000"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "marked": "^18.0.6"
  },
  "devDependencies": {
    "dompurify": "^3.4.12",
    "esbuild": "^0.28.1",
    "html2canvas": "^1.4.1",
    "jsdom": "^29.1.1",
    "jspdf": "^4.2.1",
    "pdfjs-dist": "^6.1.200",
    "serve": "^14.2.0",
    "vitest": "^4.1.11"
  }
}
